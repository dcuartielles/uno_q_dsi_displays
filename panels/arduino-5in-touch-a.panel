# Arduino 5inch-DSI-TOUCH-A - the official panel for the UNO Media Carrier.
#
# This one needs NOTHING from this repository except selecting it. Arduino ships
# the overlay, and every driver it needs is already in the UNO Q kernel:
#
#   waveshare,5.0-dsi-touch-a / himax,hx8399c  ->  panel-himax-hx8394
#   waveshare,dsi-touch-gpio  (backlight/GPIO) ->  gpio-waveshare-dsi
#   goodix,gt9271             (touch, 0x5d)    ->  goodix_ts
#
# So STOCK_SUPPORT=1 tells the installer to select Arduino's own overlay and
# stop. It must NOT build patched drivers or replace the overlay - doing so is
# actively harmful here: the patched build targets a completely different
# panel (Waveshare 800x480, one DSI lane, an RPi attiny at 0x45 and an
# edt-ft5x06 touch at 0x38), and overwriting Arduino's overlay with it leaves
# this panel dark with no connector at all. That was a real failure, not a
# hypothetical one.
#
# Verified working: connector card0-DSI-1 at 720x1280, backlight registered,
# "Goodix Capacitive TouchScreen" bound.

PANEL_ID="arduino-5in-touch-a"
PANEL_DESC="Arduino 5inch DSI-TOUCH-A (720x1280)"

# Everything below this line is what makes it different from a panel we have
# to describe ourselves.
STOCK_SUPPORT=1

# The option name arduino-linux-config already knows.
CARRIER_DISPLAY_OPTION="5-dsi-touch-a"

# Only used to report what should appear, and to check the drivers are present
# before promising anything.
STOCK_MODE="720x1280"

# Checked before promising anything. Read from here rather than hardcoded in
# the installer, because the stock panels do NOT share a panel driver - the
# 10.1 inch is a Jadard jd9365da, this one a Himax hx8394.
STOCK_DRIVERS="panel-himax-hx8394 gpio-waveshare-dsi goodix_ts"

# Kept for anything still reading the older field names.
STOCK_PANEL_DRIVER="panel-himax-hx8394"
STOCK_TOUCH_DRIVER="goodix_ts"
STOCK_GPIO_DRIVER="gpio-waveshare-dsi"
TOUCH_ADDR="0x5d"

# --- how detect-panel.sh recognises this panel -----------------------------
# The Goodix GT911 answers its product-ID register even with no overlay loaded
# and no driver bound - measured on a board set to display=none, where it
# returned "911" as ASCII while 0x38 correctly NAKed. That is what makes this
# usable on a board that has not been configured yet.
DETECT_ADDR="0x5d"
DETECT_WRITE="0x81 0x40"          # GT911 product ID register, 16-bit address
DETECT_READ="4"
DETECT_EXPECT="0x39 0x31 0x31"    # ASCII "911"
DETECT_NOTE="Goodix GT911 touch controller reports product ID 911"

# This panel carried no second probe for a long time, deliberately: "911"
# separated it from every other panel known - the 8, 10.1 and 12.3 inch all
# report 9271 - so a second stage could only add ways to fail.
#
# The Waveshare 7.0inch DSI-TOUCH-C ended that. It answers 911 as well, and
# before this stage existed it was detected, with full confidence, as an
# Arduino 5 inch. The comment above it used to say the product ID "already
# separates this panel from every other one known", which is a good reminder
# that a fingerprint is only unique across the panels you have seen.
#
# The measurements were on record either way, which is what made the fix five
# minutes' work (bench/results/goodix/arduino-5in-touch-a.txt):
#
#     config version 0x8047     0x46      9271 panels read 0x82, the 7in 0x5b
#     resolution     0x8048     720x1280  the 7in C is 1024x600
#     thresholds     0x8053     0x5a 0x3c 8in 5f 41, 10.1in 50 32, 7in 64 46
#
# Touch resolution is the one used. A digitizer's reported size is a property
# of the glass; thresholds are tuning and can plausibly move between
# production batches, so a fingerprint built on those would eventually reject
# a genuine panel.

# Touch resolution, little-endian: 0x02d0 = 720 across, 0x0500 = 1280 down.
DETECT2_WRITE="0x80 0x48"
DETECT2_READ="4"
DETECT2_EXPECT="0xd0 0x02 0x00 0x05"
