# Waveshare 800x480 DSI LCD  (4.3" and 5" variants, ICN6211 bridge on-panel)
#
# Values taken verbatim from Raspberry Pi's
#   arch/arm/boot/dts/overlays/vc4-kms-dsi-waveshare-800x480-overlay.dts
# and drivers/gpu/drm/panel/panel-simple.c
#
# Verified working on Arduino UNO Q + UNO Media Carrier, kernel 7.0.0, with
# BOTH panels this definition claims to cover:
#
#   Waveshare 5inch   DSI LCD, 15-pin FPC via a 15->22 pin adapter
#   Waveshare 4.3inch DSI LCD, 2026-09-08 - 800x480, backlight, touch, no
#                     DSI errors; the definition needed no changes at all
#
# ONE definition for both variants, deliberately
# ----------------------------------------------
# They are the same panel electrically: same 800x480 timings, same single DSI
# lane, same ICN6211 bridge, same ATTINY at 0x45, same FT5x06 touch at 0x38.
# Nothing on the I2C bus distinguishes them, so splitting this into two .panel
# files would give both the same fingerprint - and detect-panel.sh refuses to
# guess when two definitions match. One file is not a simplification here, it
# is the only correct answer.
#
# The one real difference is physical size, which affects nothing but DPI. See
# WIDTH_MM/HEIGHT_MM below if you care about it.

PANEL_ID="waveshare-800x480"

# Compatible string. Reusing RPi's keeps the definition recognisable; it is
# matched by the descriptor we add to panel-simple, so it only has to be unique.
PANEL_COMPATIBLE="waveshare,4-3-inch-dsi"

# C identifier used for the generated panel-simple descriptor.
PANEL_C_NAME="waveshare_800x480"

# --- display timings -------------------------------------------------------
# Pixel clock in kHz, porches in pixels/lines.
CLOCK_KHZ=27777
HACTIVE=800
HFRONT=59
HSYNC=2
HBACK=45
VACTIVE=480
VFRONT=7
VSYNC=2
VBACK=22

# Physical size in mm (0 = unknown). This is the only field that differs
# between the two variants, and since they cannot be told apart automatically
# it is left on the 5" figures. Set it by hand if you have the smaller one and
# care about DPI - nothing else depends on it:
#
#   5"    109 x 65
#   4.3"   95 x 54
WIDTH_MM=109
HEIGHT_MM=65

# --- DSI link --------------------------------------------------------------
DSI_LANES=1
DSI_FORMAT="MIPI_DSI_FMT_RGB888"
DSI_MODE_FLAGS="MIPI_DSI_MODE_VIDEO"
BPC=8

# --- panel power / backlight controller on I2C -----------------------------
# The ATTINY-style controller that powers the panel and drives the backlight.
PANEL_CTRL_COMPATIBLE="raspberrypi,7inch-touchscreen-panel-regulator"
PANEL_CTRL_ADDR="0x45"

# --- touch (optional; leave TOUCH_ADDR empty to omit) ----------------------
TOUCH_COMPATIBLE="edt,edt-ft5506"
TOUCH_ADDR="0x38"
TOUCH_SIZE_X=800
TOUCH_SIZE_Y=480
TOUCH_INVERT_X=1
TOUCH_INVERT_Y=1
# gpio line on the panel controller that releases the touch reset (active low)
TOUCH_RESET_GPIO=1

# --- how detect-panel.sh recognises this panel -----------------------------
# Not the touch controller: the FT5x06 at 0x38 is held in reset by the ATTINY
# until a driver releases it, so on an unconfigured board it stays silent and
# would be useless as a fingerprint. The ATTINY itself is the discriminator.
# Its REG_ID reports 0xc3 or 0xde depending on firmware revision.
#
# 0x45 is occupied on the Arduino panel too, by a different chip - so the
# address alone proves nothing and DETECT_EXPECT has to carry the weight. That
# chip answered 0x01 bare and 0xff bound, neither of which collides here.
#
# Reading is safe: it is writes to this controller, specifically to REG_PORTC,
# that wedge the CCI bus - see docs/ROOT-CAUSE.md.
#
# VERIFIED on hardware 2026-09-08 with the 4.3inch panel: REG_ID reads 0xc3,
# and detection picked this definition correctly with the other panel's
# signature absent. The 0xde alternative is still from the driver source only -
# it is a different ATTINY firmware revision, kept because dropping it would
# silently stop recognising panels that report it.
DETECT_ADDR="0x45"
DETECT_WRITE="0x80"               # REG_ID on the RPi-style panel ATTINY
DETECT_READ="1"
DETECT_EXPECT="0xc3|0xde"
DETECT_NOTE="Raspberry Pi style panel ATTINY reports REG_ID c3/de"

# Measured on the 4.3inch panel, recorded for whoever tries to tell the two
# variants apart later. If the 5inch reports different values here, that is a
# discriminator and this file can become two:
#
#   0x45 REG_ID (0x80)          0xc3
#   0x38 chip id (0xA3)         0x54
#   0x38 firmware version(0xA6) 0x0b
#   0x38 vendor id (0xA8)       0x79        -> "generic ft5x06 (79)"
#
# Read them with, for example:
#   sudo i2ctransfer -y -f <bus> w1@0x38 0xA3 r1
