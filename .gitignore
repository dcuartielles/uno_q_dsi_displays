# local build artefacts
*.ko
*.o
*.mod
*.mod.c
*.order
*.symvers
.tmp_versions/
Makefile.module

# generated on the board
*.dtbo
*.dtb
*.pristine
build.log

# never commit credentials or host-specific config
*secrets*
*.pem
*.key
id_*
known_hosts
bench/bench.conf
bench/optical-cal.json
# Benchmark records are evidence and ARE committed; the bulky
# per-iteration camera frames are not (evidence/ is kept).
bench/results/**/iter-*.png
bench/.kernel-cache/
__pycache__/
*.pyc
