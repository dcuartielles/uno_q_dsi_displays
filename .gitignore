# local build artefacts
*.ko
*.o
*.mod
*.mod.c
*.order
*.symvers
.tmp_versions/
Makefile.module

# generated on the board
*.dtbo
*.dtb
*.pristine
build.log

# never commit credentials or host-specific config
*secrets*
*.pem
*.key
id_*
known_hosts
bench/bench.conf
bench/optical-cal.json
# Benchmark records are evidence and ARE committed; the bulky
# per-iteration camera frames are not (evidence/ is kept).
bench/results/**/iter-*.png
bench/.kernel-cache/
__pycache__/
*.pyc
bench/coldboot-debug.log
tools/.prepare-run.sh
.panel-batch

# Pitch and business documents. Not part of the driver work, and iterations of
# a Word file would churn the history for no benefit. Covers every revision
# (_v001, _v002, ...) and the script that generates them.
pitch/
*_v[0-9][0-9][0-9].docx

# Material people send in to diagnose a problem - photographs, logs, scans.
# Useful while working a case, not part of the repository: it is someone
# else's hardware, often their desk and their surroundings too.
inputs/

# What tools/capture-panel.sh collects on a contributor's board. Useful while
# preparing a pull request; only the config dump belongs in the repository,
# and that goes to bench/results/goodix/.
submissions/
